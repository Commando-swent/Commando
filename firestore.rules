rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function hasExactTripFields(data) {
      return data.keys().hasAll([
        "ownerId",
        "store",
        "scheduledAt",
        "handoffLocation",
        "status",
        "createdAt",
        "updatedAt"
      ]) && data.keys().hasOnly([
        "ownerId",
        "store",
        "scheduledAt",
        "handoffLocation",
        "status",
        "createdAt",
        "updatedAt"
      ]);
    }

    function isValidLocation(location) {
      return location is map
        && location.keys().hasAll(["name", "latitude", "longitude"])
        && location.keys().hasOnly(["name", "latitude", "longitude"])
        && location.name is string
        && location.name.matches('.*\\S.*')
        && location.latitude is number
        && location.latitude >= -90
        && location.latitude <= 90
        && location.longitude is number
        && location.longitude >= -180
        && location.longitude <= 180;
    }

    function isValidTripStatus(status) {
      return status is string
        && status in ["PUBLISHED", "IN_PROGRESS", "COMPLETED", "CANCELLED"];
    }

    function isValidTrip(data) {
      return data is map
        && hasExactTripFields(data)
        && data.ownerId is string
        && isValidLocation(data.store)
        && data.scheduledAt is timestamp
        && isValidLocation(data.handoffLocation)
        && isValidTripStatus(data.status)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Trip lifecycle (#233): the owner closes (PUBLISHED -> IN_PROGRESS), then completes
    // (IN_PROGRESS -> COMPLETED); nothing else changes. The completion rule (no open order)
    // needs a query, so the app enforces it.
    function isAllowedTripTransition(from, to) {
      return (from == "PUBLISHED" && to == "IN_PROGRESS")
        || (from == "IN_PROGRESS" && to == "COMPLETED");
    }

    match /trips/{tripId} {
      allow create: if isAuthenticated()
        && isValidTrip(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == "PUBLISHED"
        && request.resource.data.createdAt == request.resource.data.updatedAt;

      // Requesters keep the trip of their order after it closes; listing stays PUBLISHED-or-owner.
      allow get: if isAuthenticated()
        && (resource == null
          || resource.data.status in ["PUBLISHED", "IN_PROGRESS", "COMPLETED"]
          || resource.data.ownerId == request.auth.uid);

      allow list: if isAuthenticated()
        && (resource.data.status == "PUBLISHED"
          || resource.data.ownerId == request.auth.uid);

      allow update: if isAuthenticated()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"])
        && request.resource.data.updatedAt == request.time
        && isAllowedTripTransition(resource.data.status, request.resource.data.status);

      // The app never deletes trips; deleting and recreating one would bypass the transitions and
      // strand its orders.
      allow delete: if false;
    }

    // Order access is anchored to the persisted associated trip.
    function ownsOrderTrip(data) {
      return get(/databases/$(database)/documents/trips/$(data.tripId)).data.ownerId == request.auth.uid;
    }

    // Bounded lists allow exhaustive item, uniqueness and Int-total validation without loops.
    function validOrderItem(item) {
      let id = item.productId;
      let name = item.name;
      let price = item.unitPriceCents;
      let quantity = item.quantity;
      // Missing fields or wrong map/string types fail closed during evaluation.
      return item.keys().hasOnly(["productId", "name", "unitPriceCents", "quantity"])
        && id.matches('(?s).*[^\\s\\p{Z}\\x{001c}-\\x{001f}].*') && name.matches('(?s).*[^\\s\\p{Z}\\x{001c}-\\x{001f}].*')
        && price is int && price >= 0 && price <= 2147483647
        && quantity is int && quantity > 0 && quantity <= 2147483647
        && price * quantity <= 2147483647;
    }

    function checkedTotal(items, index) {
      let item = items.size() > index ? items[index] : null;
      return items.size() <= index ? 0 : validOrderItem(item)
        ? item.unitPriceCents * item.quantity : 2147483648;
    }

    function productAt(items, index) {
      return items.size() <= index ? null : items[index].productId;
    }

    function validOrderItems(items, fee) {
      return fee + checkedTotal(items, 0) + checkedTotal(items, 1) + checkedTotal(items, 2)
          + checkedTotal(items, 3) + checkedTotal(items, 4) <= 2147483647
        && [productAt(items, 0), productAt(items, 1), productAt(items, 2),
          productAt(items, 3), productAt(items, 4)].removeAll([null]).toSet().size() == items.size();
    }

    match /orders/{orderId} {
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(["tripId", "requesterId", "items", "commissionCents", "status", "createdAt"])
        && request.resource.data.keys().hasOnly(["tripId", "requesterId", "items", "commissionCents", "status", "createdAt", "revision"])
        && request.resource.data.get("revision", 0) is int
        && request.resource.data.get("revision", 0) == 0
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.tripId is string
        && request.resource.data.tripId.matches('[^/]+')
        && request.resource.data.commissionCents is int
        && request.resource.data.commissionCents >= 0
        && request.resource.data.commissionCents <= 2147483647
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 5
        && validOrderItems(request.resource.data.items, request.resource.data.commissionCents)
        && request.resource.data.status == "PENDING"
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/trips/$(request.resource.data.tripId)).data.ownerId != request.auth.uid
        && get(/databases/$(database)/documents/trips/$(request.resource.data.tripId)).data.status == "PUBLISHED"
        && get(/databases/$(database)/documents/trips/$(request.resource.data.tripId)).data.scheduledAt > request.time
        && hasOrderEvent(orderId, "ORDER_PLACED",
          get(/databases/$(database)/documents/trips/$(request.resource.data.tripId)).data.ownerId);
      allow get: if isAuthenticated() && (resource == null
        || resource.data.requesterId == request.auth.uid || ownsOrderTrip(resource.data));
      // Queries must filter by requesterId == uid, or by a tripId the caller owns (#147).
      allow list: if isAuthenticated()
        && (resource.data.requesterId == request.auth.uid || ownsOrderTrip(resource.data));
      allow update: if isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"])
        && ((ownsOrderTrip(resource.data)
              && resource.data.requesterId != request.auth.uid
              && ((resource.data.status == "PENDING"
                    && request.resource.data.status in ["ACCEPTED", "REJECTED"]
                    && hasOrderEvent(orderId, "ORDER_" + request.resource.data.status, resource.data.requesterId))
                  || (resource.data.status == "ACCEPTED"
                    && request.resource.data.status == "READY_FOR_HANDOFF")))
            || (resource.data.status == "PENDING"
              && resource.data.requesterId == request.auth.uid
              && request.resource.data.status == "CANCELLED")
            || (resource.data.requesterId == request.auth.uid
              && resource.data.status == "READY_FOR_HANDOFF"
              && request.resource.data.status == "DELIVERED"));
      // Requester edits preserve identity/status and independently revalidate the whole payload.
      allow update: if isAuthenticated()
        && resource.data.requesterId == request.auth.uid
        && resource.data.status == "PENDING"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["items", "commissionCents", "revision"])
        && request.resource.data.revision is int
        && request.resource.data.revision == resource.data.get("revision", 0) + 1
        && request.resource.data.revision <= 2147483647
        && request.resource.data.commissionCents is int
        && request.resource.data.commissionCents >= 0
        && request.resource.data.commissionCents <= 2147483647
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 5
        && validOrderItems(request.resource.data.items, request.resource.data.commissionCents)
        && get(/databases/$(database)/documents/trips/$(resource.data.tripId)).data.ownerId != request.auth.uid
        && get(/databases/$(database)/documents/trips/$(resource.data.tripId)).data.status == "PUBLISHED"
        && get(/databases/$(database)/documents/trips/$(resource.data.tripId)).data.scheduledAt > request.time;
      allow delete: if false;
    }

    // Ratings (#261): each immutable feedback and its exact summary increment commit together.
    function ratingParticipant(orderId) {
      let order = get(/databases/$(database)/documents/orders/$(orderId)).data;
      return order.requesterId == request.auth.uid || ownsOrderTrip(order);
    }

    function validRating(orderId, data) {
      let order = get(/databases/$(database)/documents/orders/$(orderId)).data;
      let owner = get(/databases/$(database)/documents/trips/$(order.tripId)).data.ownerId;
      return data.keys().hasAll(["orderId", "tripId", "requesterId", "commandoId", "score", "comment", "createdAt"])
        && data.keys().hasOnly(["orderId", "tripId", "requesterId", "commandoId", "score", "comment", "createdAt"])
        && data.orderId == orderId && data.tripId == order.tripId
        && data.requesterId == order.requesterId && data.requesterId == request.auth.uid
        && data.commandoId == owner && owner != request.auth.uid && order.status == "DELIVERED"
        && data.score is int && data.score >= 1 && data.score <= 5
        && data.createdAt == request.time
        // Count supplementary characters twice, matching Kotlin's UTF-16 String.length.
        && (data.comment == null || (data.comment is string
          && data.comment.matches('(?s).*[^\\x{0009}-\\x{000d}\\x{001c}-\\x{001f}\\p{Z}].*')
          && data.comment.replace('[\\x{10000}-\\x{10ffff}]', 'xx').size() <= 250));
    }

    function validRatingSummary(commandoId, data) {
      let ratingPath = /databases/$(database)/documents/ratings/$(data.lastOrderId);
      let rating = getAfter(ratingPath).data;
      let summaryPath = /databases/$(database)/documents/ratingSummaries/$(commandoId);
      let old = exists(summaryPath) ? get(summaryPath).data : {"ratingCount": 0, "scoreTotal": 0};
      return data.keys().hasAll(["ratingCount", "scoreTotal", "lastOrderId"])
        && data.keys().hasOnly(["ratingCount", "scoreTotal", "lastOrderId"])
        && data.lastOrderId is string && data.lastOrderId.matches('[^/]+')
        && !exists(ratingPath) && rating.commandoId == commandoId
        && rating.requesterId == request.auth.uid
        && data.ratingCount is int && data.ratingCount > 0 && data.ratingCount <= 2147483647
        && data.scoreTotal is int
        && data.ratingCount == old.ratingCount + 1 && data.scoreTotal == old.scoreTotal + rating.score;
    }

    match /ratings/{orderId} {
      allow get: if isAuthenticated() && ratingParticipant(orderId);
      allow create: if isAuthenticated() && validRating(orderId, request.resource.data)
        && getAfter(/databases/$(database)/documents/ratingSummaries/$(request.resource.data.commandoId)).data.lastOrderId == orderId
        && validRatingSummary(request.resource.data.commandoId,
          getAfter(/databases/$(database)/documents/ratingSummaries/$(request.resource.data.commandoId)).data);
      allow list, update, delete: if false;
    }

    match /ratingSummaries/{commandoId} {
      allow get: if isAuthenticated();
      allow create, update: if isAuthenticated() && validRatingSummary(commandoId, request.resource.data);
      allow list, delete: if false;
    }

    // Shopping checklist progress (#193): only the owner of trips/{tripId} may read or write it.
    function ownsTrip(tripId) {
      return get(/databases/$(database)/documents/trips/$(tripId)).data.ownerId == request.auth.uid;
    }

    // One document per checked product, so progress is as unbounded as the trip's orders.
    // Unchecking deletes the document. The key is the SHA-256 of the product ID, which may
    // contain characters that document IDs cannot; one product has exactly one document.
    match /shoppingChecklists/{tripId}/items/{key} {
      allow read, delete: if isAuthenticated() && ownsTrip(tripId);
      allow create, update: if isAuthenticated() && ownsTrip(tripId)
        && request.resource.data.keys().hasAll(["productId", "quantity", "updatedAt"])
        && request.resource.data.keys().hasOnly(["productId", "quantity", "updatedAt"])
        && request.resource.data.productId is string
        && key == hashing.sha256(request.resource.data.productId).toHexString().lower()
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0
        && request.resource.data.updatedAt == request.time;
    }

    // Every event and its order transition must commit together; neither side can be forged alone.
    function hasOrderEvent(orderId, type, recipient) {
      let eventId = orderId + "_" + type;
      let event = getAfter(/databases/$(database)/documents/orderEvents/$(eventId)).data;
      return event.orderId == orderId && event.type == type
        && event.recipientId == recipient && event.occurredAt == request.time;
    }

    function validOrderEvent(eventId, data) {
      let path = /databases/$(database)/documents/orders/$(data.orderId);
      let order = getAfter(path).data;
      let trip = get(/databases/$(database)/documents/trips/$(order.tripId)).data;
      return data.keys().hasAll(["orderId", "recipientId", "type", "occurredAt"])
        && data.keys().hasOnly(["orderId", "recipientId", "type", "occurredAt"])
        && data.orderId is string && data.orderId.matches('[^/]+')
        && data.recipientId is string && data.recipientId.matches('[^/]+')
        && eventId == data.orderId + "_" + data.type && data.occurredAt == request.time
        && (data.type == "ORDER_PLACED"
          ? (!exists(path) && order.status == "PENDING" && order.createdAt == request.time
            && request.auth.uid == order.requesterId && data.recipientId == trip.ownerId)
          : (exists(path) && get(path).data.status == "PENDING"
            && data.type in ["ORDER_ACCEPTED", "ORDER_REJECTED"]
            && data.type == "ORDER_" + order.status
            && request.auth.uid == trip.ownerId && data.recipientId == order.requesterId));
    }

    match /orderEvents/{eventId} {
      allow read: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
      allow create: if isAuthenticated() && validOrderEvent(eventId, request.resource.data);
      allow update, delete: if false;
    }

    function ownsNotificationData(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function notificationEnabled(userId, type) {
      let path = /databases/$(database)/documents/users/$(userId)/notificationPreferences/settings;
      return !exists(path) || (type == "ORDER_PLACED"
        ? get(path).data.newOrders : get(path).data.orderDecisions);
    }

    function validInboxEntry(data, userId, eventId) {
      let event = get(/databases/$(database)/documents/orderEvents/$(eventId)).data;
      return data.keys().hasAll(["orderId", "recipientId", "type", "occurredAt", "visible", "isRead"])
        && data.keys().hasOnly(["orderId", "recipientId", "type", "occurredAt", "visible", "isRead"])
        && event.recipientId == userId && data.recipientId == userId
        && data.orderId == event.orderId && data.type == event.type
        && data.occurredAt == event.occurredAt
        && data.isRead == false && data.visible is bool
        && data.visible == notificationEnabled(userId, event.type);
    }

    match /users/{userId}/notifications/{eventId} {
      allow read: if ownsNotificationData(userId);
      allow create: if ownsNotificationData(userId)
        && validInboxEntry(request.resource.data, userId, eventId);
      allow update: if ownsNotificationData(userId) && resource.data.visible == true
        && request.resource.data.isRead == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["isRead"]);
      allow delete: if false;
    }

    match /users/{userId}/notificationPreferences/settings {
      allow get: if ownsNotificationData(userId);
      allow create, update: if ownsNotificationData(userId)
        && request.resource.data.keys().hasAll(["newOrders", "orderDecisions"])
        && request.resource.data.keys().hasOnly(["newOrders", "orderDecisions"])
        && request.resource.data.newOrders is bool && request.resource.data.orderDecisions is bool;
      allow delete: if false;
    }

    // Private product references; product details remain canonical under stores/{storeId}/products.
    match /users/{userId}/favourites/{productId} {
      allow read, delete: if isAuthenticated() && request.auth.uid == userId;
      allow create, update: if isAuthenticated() && request.auth.uid == userId
        && request.resource.data.keys().hasAll(["productId", "storeId"])
        && request.resource.data.keys().hasOnly(["productId", "storeId"])
        && request.resource.data.productId == productId
        && request.resource.data.storeId in ["migros", "coop"]
        // As in ProductRepositoryFirestore: the part after the prefix is a product document ID.
        && productId.matches(request.resource.data.storeId + ':[^\\s/]([^/]*[^\\s/])?')
        && !(productId in [request.resource.data.storeId + ':.', request.resource.data.storeId + ':..']);
    }

    // Importer-written store metadata, such as its sorted product categories.
    match /stores/{storeId} {
      allow get: if isAuthenticated();
    }

    match /stores/{storeId}/products/{productId} {
      allow get: if isAuthenticated();
      allow list: if isAuthenticated()
        && request.query.limit != null
        && request.query.limit <= 50;
      allow create, update, delete: if false;
    }

    match /profilePhotos/{userId} {
      allow get, delete: if isAuthenticated() && request.auth.uid == userId;
      allow create, update: if isAuthenticated() && request.auth.uid == userId
        && request.resource.data.keys().hasAll(["photo", "updatedAt"])
        && request.resource.data.keys().hasOnly(["photo", "updatedAt"])
        && request.resource.data.photo is bytes
        && request.resource.data.photo.size() > 0
        && request.resource.data.photo.size() <= 204800
        && request.resource.data.updatedAt == request.time;
    }
  }
}
